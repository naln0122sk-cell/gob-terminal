<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GOB SECURE INTRANET (v10.0 PDF-EXPORT)</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        :root {
            --bg-color: #020202;
            --container-bg: #0a0e17;
            --primary-color: #10b981; 
            --accent-color: #ef4444;  
            --warning-color: #f59e0b; 
            --border-color: #1f2937;
            --text-color: #d1d5db;
            --input-bg: #000000;
        }

        body {
            font-family: 'Malgun Gothic', dotum, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            overflow-x: hidden;
            display: flex;
            justify-content: center;
            min-height: 100vh;
        }

        body::after {
            content: " ";
            display: block;
            position: fixed;
            top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
            z-index: 9999;
            background-size: 100% 2px, 3px 100%;
            pointer-events: none;
        }

        #authScreen {
            width: 100%; max-width: 400px;
            margin-top: 10vh; background: var(--input-bg);
            border: 1px solid var(--primary-color);
            box-shadow: 0 0 20px rgba(16, 185, 129, 0.2);
            padding: 40px; display: flex; flex-direction: column;
            gap: 15px; z-index: 9001; font-family: 'Courier New', Courier, monospace;
        }

        .login-title {
            text-align: center; color: var(--primary-color);
            font-size: 18px; font-weight: bold; margin-bottom: 5px;
            border-bottom: 1px solid var(--primary-color); padding-bottom: 10px;
        }

        .login-input {
            width: 100%; background: #000; border: 1px solid var(--border-color);
            color: var(--primary-color); padding: 12px; font-family: 'Courier New', Courier, monospace;
            box-sizing: border-box; outline: none; margin-bottom: 10px;
        }

        .login-input:focus { border-color: var(--primary-color); box-shadow: inset 0 0 5px rgba(16, 185, 129, 0.2); }

        .btn-login {
            background: transparent; color: var(--primary-color);
            border: 1px solid var(--primary-color); padding: 12px;
            font-weight: bold; cursor: pointer; transition: 0.2s;
            font-family: 'Courier New', Courier, monospace; width: 100%;
        }

        .btn-login:hover { background: var(--primary-color); color: #000; }
        
        .auth-msg { font-size: 12px; text-align: center; height: 15px; margin-bottom: 5px; }
        .error-text { color: var(--accent-color); }
        .success-text { color: var(--primary-color); }
        .text-link { font-size: 11px; color: #6b7280; cursor: pointer; text-decoration: underline; transition: 0.2s; }
        .text-link:hover { color: var(--primary-color); }

        #bootScreen {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-color: #000; z-index: 9000; color: var(--primary-color);
            font-family: 'Courier New', Courier, monospace; padding: 30px; box-sizing: border-box;
            font-size: 14px; display: none; flex-direction: column;
        }

        .cursor-blink {
            display: inline-block; width: 8px; height: 15px; background-color: var(--primary-color);
            animation: blink 1s step-end infinite; vertical-align: middle; margin-left: 2px;
        }
        @keyframes blink { 50% { opacity: 0; } }

        .container {
            width: 100%; max-width: 950px; background: var(--container-bg);
            border: 1px solid var(--primary-color); box-shadow: 0 0 20px rgba(16, 185, 129, 0.15);
            display: none; animation: terminalLoad 0.5s ease-out forwards; margin-bottom: 50px;
        }

        @keyframes terminalLoad { 0% { opacity: 0; transform: scale(0.98); } 100% { opacity: 1; transform: scale(1); } }

        .sys-status-bar {
            background-color: var(--primary-color); color: #000; padding: 5px 15px;
            font-family: 'Courier New', Courier, monospace; font-size: 12px; font-weight: bold; display: flex; justify-content: space-between;
        }

        .sys-status-inner { padding: 25px 35px; }

        h1 {
            text-align: center; color: var(--primary-color); margin-top: 0; margin-bottom: 5px;
            letter-spacing: 4px; font-size: 26px; font-family: 'Courier New', Courier, monospace; text-shadow: 0 0 8px rgba(16, 185, 129, 0.4);
        }

        .system-v {
            text-align: center; font-size: 11px; color: #10b981; opacity: 0.7; margin-bottom: 25px; font-family: monospace;
        }

        .section-title {
            color: var(--primary-color); font-size: 13px; font-weight: bold; margin-top: 30px; margin-bottom: 15px;
            border-bottom: 1px solid #1f2937; padding-bottom: 5px; font-family: 'Courier New', Courier, monospace;
        }

        .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
        .form-group { display: flex; flex-direction: column; gap: 5px; margin-bottom: 15px; }
        .form-group.full-width { grid-column: span 2; }
        .form-group label { font-weight: bold; font-size: 11px; color: #6b7280; font-family: 'Courier New', Courier, monospace; }

        input[type="text"], input[type="password"], input[type="date"], select {
            padding: 8px 10px; background-color: var(--input-bg); color: var(--primary-color);
            border: 1px solid var(--border-color); font-size: 13px; box-sizing: border-box; width: 100%; font-family: 'Courier New', Courier, monospace;
        }
        input:focus, select:focus, textarea:focus { outline: none; border-color: var(--primary-color); box-shadow: inset 0 0 5px rgba(16, 185, 129, 0.2); }

        textarea {
            width: 100%; padding: 12px; background-color: var(--input-bg); color: var(--primary-color);
            border: 1px solid var(--border-color); box-sizing: border-box; font-family: 'Courier New', Courier, monospace;
            font-size: 13px; resize: vertical; line-height: 1.5;
        }

        .btn-action {
            background-color: transparent; color: var(--primary-color); border: 1px solid var(--primary-color);
            padding: 12px; font-size: 14px; font-weight: bold; cursor: pointer; width: 100%; font-family: 'Courier New', Courier, monospace;
            letter-spacing: 2px; transition: 0.2s; margin-top: 15px;
        }
        .btn-action:hover { background-color: var(--primary-color); color: #000; box-shadow: 0 0 10px rgba(16, 185, 129, 0.4); }

        .output-area { margin-top: 20px; display: none; }
        
        .enc-block {
            background-color: #000; color: var(--primary-color); border: 1px solid #1f2937;
            padding: 20px; white-space: pre-wrap; font-family: 'Courier New', Courier, monospace; font-size: 12px; line-height: 1.6; word-break: break-all;
        }

        /* PDF 컨테이너 (인쇄용 스타일 적용을 위해 래핑) */
        #pdfContainer {
            background-color: #000;
            padding: 15px;
            border-radius: 5px;
        }

        .radio-group { display: flex; gap: 20px; margin-top: 10px; font-family: 'Courier New', Courier, monospace; font-size: 12px; }
        .radio-group label { color: var(--primary-color); cursor: pointer; }
        
        .crypto-box {
            border: 1px dashed var(--primary-color); padding: 15px; margin-top: 20px; background: rgba(16,185,129,0.05); position: relative;
        }

        .binding-badge {
            position: absolute; top: -10px; right: 15px; background-color: var(--primary-color); color: #000; font-weight: bold; font-size: 10px; padding: 2px 8px; border-radius: 3px;
        }

        .manual-decrypt-box {
            border: 1px dashed var(--accent-color); padding: 15px; margin-top: 15px; background: rgba(239,68,68,0.05); display: none; position: relative;
        }

        .binding-badge-red {
            position: absolute; top: -10px; right: 15px; background-color: var(--accent-color); color: #000; font-weight: bold; font-size: 10px; padding: 2px 8px; border-radius: 3px;
        }
        
        .btn-decrypt {
            background: transparent; color: var(--accent-color); border: 1px solid var(--accent-color);
            padding: 10px; width: 100%; font-family: monospace; font-weight: bold; cursor: pointer;
            margin-top: 10px; transition: 0.2s;
        }
        .btn-decrypt:hover { background: var(--accent-color); color: #000; }
        
        .action-links {
            display: flex; gap: 15px;
        }
        .action-link {
            cursor: pointer; text-decoration: underline; font-size: 12px; transition: color 0.2s;
        }
        .action-link:hover { color: #fff; }

        /* 퀵룩 경고 배너 */
        #quickLookWarning {
            background: var(--warning-color); color: #000; text-align: center; font-size: 11px; padding: 5px; font-weight: bold; display: none; font-family: monospace;
        }
    </style>
</head>
<body>

<div id="quickLookWarning">[!] RESTRICTED MODE: OFFLINE/QUICK-LOOK ENVIRONMENT DETECTED. LIMITED FUNCTIONALITY ACTIVE.</div>

<div id="authScreen">
    <div class="login-title">GOB SECURE COMM-LINK</div>
    <div id="loginForm">
        <div style="font-size: 11px; color: #6b7280; text-align: center; margin-bottom: 15px;">[ IDENTIFICATION REQUIRED ]</div>
        <input type="text" id="loginId" class="login-input" placeholder="AGENT ID" autocomplete="off">
        <input type="password" id="loginPw" class="login-input" placeholder="PASSCODE">
        <div id="loginError" class="auth-msg error-text"></div>
        <button class="btn-login" onclick="verifyLogin()">[ AUTHENTICATE ]</button>
        <div style="text-align:center; margin-top:15px;">
            <span class="text-link" onclick="toggleAuthMode('register')">>> REGISTER NEW AGENT</span>
        </div>
    </div>
    <div id="registerForm" style="display: none;">
        <div style="font-size: 11px; color: var(--warning-color); text-align: center; margin-bottom: 15px;">[ SYSTEM REGISTRATION ]</div>
        <input type="text" id="regId" class="login-input" style="border-color: var(--warning-color);" placeholder="NEW AGENT ID" autocomplete="off">
        <input type="password" id="regPw" class="login-input" style="border-color: var(--warning-color);" placeholder="NEW PASSCODE">
        <input type="password" id="regPwConfirm" class="login-input" style="border-color: var(--warning-color);" placeholder="CONFIRM PASSCODE">
        <div id="regMsg" class="auth-msg"></div>
        <button class="btn-login" style="color:var(--warning-color); border-color:var(--warning-color);" onclick="registerUser()">[ REGISTER ]</button>
        <div style="text-align:center; margin-top:15px;">
            <span class="text-link" onclick="toggleAuthMode('login')"><< BACK TO LOGIN</span>
        </div>
    </div>
</div>

<div id="bootScreen">
    <div id="bootLog"></div>
    <div><span class="cursor-blink"></span></div>
</div>

<div class="container" id="mainTerminal">
    <div class="sys-status-bar">
        <span>[NODE: SECURE-LINK-01]</span>
        <span id="loggedInAgentDisplay">AGENT: -</span>
        <span id="realTimeClock">00:00:00 KST</span>
    </div>

    <div class="sys-status-inner">
        <h1>GOB COMM PROTOCOL</h1>
        <div class="system-v">PDF EXPORT & CRYPTO MODULE (v10.0)</div>
        
        <div class="section-title">>> SYS.OP.1 : ENCRYPT MESSAGE (발신)</div>
        
        <div class="form-grid">
            <div class="form-group">
                <label>OPERATION TITLE</label>
                <input type="text" id="subject" placeholder="INPUT OPERATION NAME">
            </div>
            <div class="form-group">
                <label>AUTHOR ID</label>
                <input type="text" id="author" placeholder="YOUR AGENT ID" readonly style="background-color: #111827;">
            </div>
        </div>

        <div class="form-group">
            <label>RAW OBSERVATION LOG</label>
            <textarea id="logData" rows="4" placeholder="> 공유할 기밀 내용을 입력하십시오..."></textarea>
        </div>

        <div class="crypto-box">
            <div class="binding-badge">CORE-BOUND ENABLED</div>
            <label style="color: var(--primary-color); font-weight:bold;">ENCRYPTION MODE (보안 모드 선택)</label>
            <div style="font-size: 10px; color: #6b7280; margin-top: 5px;">* 암호문은 시스템 고유 해시와 결합되어 이 HTML에서만 복호화 가능합니다.</div>
            <div class="radio-group">
                <label><input type="radio" name="encMode" value="auto" checked onchange="toggleEncMode()"> 1. AUTO (본인 세션 키)</label><br>
                <label><input type="radio" name="encMode" value="custom" onchange="toggleEncMode()"> 2. CUSTOM (외부 공유 키)</label>
            </div>
            <div id="customEncKeyWrapper" style="display:none; margin-top:15px;">
                <input type="password" id="customEncKey" placeholder="수신자에게 전달할 비밀번호를 입력하십시오 (AES-256)">
            </div>
        </div>

        <button class="btn-action" onclick="compileDocument()">[ ENCRYPT DATA ]</button>

        <div id="outputArea" class="output-area">
            <div style="display:flex; justify-content:space-between; margin-bottom:5px; align-items: flex-end;">
                <span style="color: var(--primary-color); font-weight: bold; font-family: monospace;">>> ENCRYPTED CIPHERTEXT</span>
                <div class="action-links">
                    <span class="action-link" onclick="copyOutput()">[COPY]</span>
                    <span class="action-link" onclick="downloadPDF('pdfContainer', 'GOB_Encrypted_Report.pdf')">[EXPORT .PDF]</span>
                </div>
            </div>
            <div id="pdfContainer">
                <div id="documentOutput" class="enc-block" style="color: var(--warning-color); border:none; padding:0;"></div>
            </div>
        </div>

        <br><br>
        
        <div class="section-title" style="color: var(--warning-color); border-bottom-color: #4b5563;">>> SYS.OP.2 : DECRYPT MESSAGE (수신)</div>
        
        <div class="form-group">
            <label style="color: var(--warning-color);">INCOMING CIPHERTEXT (암호문 붙여넣기)</label>
            <textarea id="cipherInput" rows="4" style="color: var(--warning-color); border-color: var(--warning-color);" placeholder="-----BEGIN GOB ENCRYPTED MESSAGE----- 로 시작하는 텍스트를 붙여넣으십시오..."></textarea>
        </div>

        <div id="manualDecWrapper" class="manual-decrypt-box">
            <div class="binding-badge-red">CORE-BOUND ENABLED</div>
            <div style="font-weight:bold; margin-bottom:10px;">>> AUTO-DECRYPT FAILED. EXTERNAL KEY DETECTED.</div>
            <div style="font-size:11px; color:#9ca3af; margin-bottom:10px;">이 문서는 커스텀 암호키로 보호되어 있습니다. 전달받은 공유 키를 입력하십시오.</div>
            <input type="password" id="manualDecKey" placeholder="EXTERNAL SHARE KEY (공유 키 입력)" style="border-color: var(--accent-color); color: var(--accent-color);">
            <button class="btn-decrypt" onclick="manualDecrypt()">[ FORCE DECRYPT ]</button>
        </div>

        <div id="decryptArea" class="output-area">
            <div style="display:flex; justify-content:space-between; margin-bottom:5px; align-items: flex-end;">
                <span style="color: var(--warning-color); font-weight: bold; font-family: monospace;">>> DECRYPTED RESULT</span>
                <div class="action-links">
                    <span class="action-link" style="color: var(--warning-color);" onclick="downloadPDF('pdfContainerDec', 'GOB_Decrypted_Report.pdf')">[EXPORT .PDF]</span>
                </div>
            </div>
            <div id="pdfContainerDec" style="background-color:#000; padding:15px; border-radius:5px;">
                <div id="decryptOutput" class="enc-block" style="color: #fff; border:none; padding:0;"></div>
            </div>
        </div>
    </div>
</div>

<script>
    // --- 0. 샌드박스 대응 & 시스템 솔트 ---
    const DB_KEY = 'gob_comm_db';
    const SYSTEM_CORE_SALT = "[[GOB_TERMINAL_V10_ENFORCER_HASH_77XQ#91]]";
    
    let memoryDB = { "ADMIN": "dimitri" };
    let isQuickLook = false;
    let currentUser = '';
    let sessionKey = ''; 

    function getDB() {
        try {
            const data = localStorage.getItem(DB_KEY);
            return data ? JSON.parse(data) : memoryDB;
        } catch(e) {
            isQuickLook = true;
            return memoryDB;
        }
    }

    function saveDB(db) {
        memoryDB = db; 
        try { localStorage.setItem(DB_KEY, JSON.stringify(db)); } 
        catch(e) { isQuickLook = true; }
    }

    function initDB() {
        let db = getDB();
        if (db["ADMIN"] !== "dimitri") {
            db["ADMIN"] = "dimitri";
            saveDB(db);
        }
        if (isQuickLook) document.getElementById('quickLookWarning').style.display = 'block';
    }
    initDB();

    function encryptData(text, key) {
        if (typeof CryptoJS !== 'undefined') {
            return CryptoJS.AES.encrypt(text, key).toString();
        } else {
            isQuickLook = true;
            document.getElementById('quickLookWarning').style.display = 'block';
            return btoa(encodeURIComponent(text + "||" + key));
        }
    }

    function decryptData(cipher, key) {
        if (typeof CryptoJS !== 'undefined') {
            const bytes = CryptoJS.AES.decrypt(cipher, key);
            return bytes.toString(CryptoJS.enc.Utf8);
        } else {
            const decoded = decodeURIComponent(atob(cipher));
            if (decoded.endsWith("||" + key)) { return decoded.replace("||" + key, ""); } 
            else { throw new Error("Invalid Key"); }
        }
    }

    // --- 1. 인증 모듈 ---
    function toggleAuthMode(mode) {
        document.getElementById('loginError').textContent = '';
        document.getElementById('regMsg').textContent = '';
        if(mode === 'register') {
            document.getElementById('loginForm').style.display = 'none';
            document.getElementById('registerForm').style.display = 'block';
        } else {
            document.getElementById('registerForm').style.display = 'none';
            document.getElementById('loginForm').style.display = 'block';
        }
    }

    function registerUser() {
        const id = document.getElementById('regId').value.trim().toUpperCase();
        const pw = document.getElementById('regPw').value;
        const pwConfirm = document.getElementById('regPwConfirm').value;
        const msgBox = document.getElementById('regMsg');

        if (!id || !pw) { msgBox.className = 'auth-msg error-text'; msgBox.textContent = '>> ID and Passcode required.'; return; }
        if (pw !== pwConfirm) { msgBox.className = 'auth-msg error-text'; msgBox.textContent = '>> Passcodes do not match.'; return; }

        let db = getDB();
        if (db[id]) { msgBox.className = 'auth-msg error-text'; msgBox.textContent = '>> ID exists.'; return; }

        db[id] = pw;
        saveDB(db);
        msgBox.className = 'auth-msg success-text'; msgBox.textContent = '>> REGISTRATION SUCCESSFUL.';
        
        setTimeout(() => {
            document.getElementById('regId').value = ''; document.getElementById('regPw').value = ''; document.getElementById('regPwConfirm').value = '';
            toggleAuthMode('login'); document.getElementById('loginId').value = id; 
        }, 1500);
    }

    function verifyLogin() {
        const id = document.getElementById('loginId').value.trim().toUpperCase();
        const pw = document.getElementById('loginPw').value;
        const err = document.getElementById('loginError');
        
        let db = getDB();
        if(db[id] && db[id] === pw) {
            currentUser = id; sessionKey = pw; 
            document.getElementById('author').value = currentUser; 
            document.getElementById('loggedInAgentDisplay').textContent = "AGENT: " + currentUser;

            document.getElementById('authScreen').style.display = "none";
            document.getElementById('bootScreen').style.display = "flex";
            startBootSequence();
        } else {
            err.textContent = ">> ACCESS DENIED: Invalid Credentials.";
            document.getElementById('loginPw').value = "";
        }
    }

    document.getElementById('loginPw').addEventListener("keypress", function(event) { if (event.key === "Enter") verifyLogin(); });

    // --- 2. 부팅 시퀀스 ---
    function startBootSequence() {
        const bootLines = [
            "ESTABLISHING COMM-LINK...",
            `AUTHENTICATING AGENT [${currentUser}]...`,
            "LOADING PDF RENDER ENGINE...",
            "TERMINAL SECURED AND READY."
        ];
        let lineIdx = 0;
        const bootLogEl = document.getElementById('bootLog');
        
        function typeLine() {
            if (lineIdx < bootLines.length) {
                const div = document.createElement('div');
                div.textContent = "> " + bootLines[lineIdx];
                bootLogEl.appendChild(div);
                lineIdx++;
                setTimeout(typeLine, Math.random() * 200 + 100);
            } else {
                setTimeout(() => {
                    document.getElementById('bootScreen').style.display = 'none';
                    document.getElementById('mainTerminal').style.display = 'block';
                    startClock();
                }, 500);
            }
        }
        typeLine();
    }

    function startClock() {
        setInterval(() => {
            document.getElementById('realTimeClock').textContent = new Date().toTimeString().split(' ')[0] + " KST";
        }, 1000);
    }

    // --- 3. 문서 작성 및 암호화 ---
    function toggleEncMode() {
        const mode = document.querySelector('input[name="encMode"]:checked').value;
        const customWrap = document.getElementById('customEncKeyWrapper');
        if (mode === 'custom') customWrap.style.display = 'block';
        else { customWrap.style.display = 'none'; document.getElementById('customEncKey').value = ''; }
    }

    function compileDocument() {
        const subj = document.getElementById('subject').value || 'REDACTED';
        const author = document.getElementById('author').value || 'UNKNOWN';
        const log = document.getElementById('logData').value || 'NO DATA';
        const mode = document.querySelector('input[name="encMode"]:checked').value;
        const customKey = document.getElementById('customEncKey').value;
        const date = new Date().toISOString().split('T')[0];

        let rawText = `[Ref: GOB-INT-${date.replace(/-/g,'')}]\n[Subject: ${subj}]\n[Agent: ${author}]\n\n--- OBSERVATION LOG ---\n${log}\n-----------------------`;

        let userKey = sessionKey;
        if (mode === 'custom') {
            if(!customKey) { alert("SYSTEM: 커스텀 암호키를 입력하십시오."); return; }
            userKey = customKey;
        }

        const boundEncryptionKey = userKey + SYSTEM_CORE_SALT;
        const outBox = document.getElementById('documentOutput');
        const ciphertext = encryptData(rawText, boundEncryptionKey);
        
        outBox.textContent = `-----BEGIN GOB ENCRYPTED MESSAGE-----\n${ciphertext}\n-----END GOB ENCRYPTED MESSAGE-----`;
        document.getElementById('outputArea').style.display = 'block';
        document.getElementById('outputArea').scrollIntoView({ behavior: 'smooth', block: 'end' });
    }

    function copyOutput() {
        try {
            navigator.clipboard.writeText(document.getElementById('documentOutput').textContent).then(() => {
                alert('SYSTEM: DATA COPIED TO CLIPBOARD.');
            });
        } catch(e) { alert('SYSTEM: 텍스트를 수동으로 선택하여 복사해 주십시오.'); }
    }

    // --- 4. 문서 복호화 ---
    document.getElementById('cipherInput').addEventListener('input', function() {
        const inputText = this.value.trim();
        const decBox = document.getElementById('decryptOutput');
        const decArea = document.getElementById('decryptArea');
        const manualWrap = document.getElementById('manualDecWrapper');

        if (inputText.includes("BEGIN GOB ENCRYPTED MESSAGE")) {
            let cipherText = inputText.replace(/-----BEGIN GOB ENCRYPTED MESSAGE-----/g, "")
                                      .replace(/-----END GOB ENCRYPTED MESSAGE-----/g, "")
                                      .trim();
            try {
                const boundDecryptionKey = sessionKey + SYSTEM_CORE_SALT;
                const originalText = decryptData(cipherText, boundDecryptionKey);
                if (!originalText) throw new Error();

                decBox.textContent = originalText;
                decArea.style.display = 'block';
                manualWrap.style.display = 'none'; 
            } catch (e) {
                decArea.style.display = 'none';
                manualWrap.style.display = 'block';
            }
        } else {
            decArea.style.display = 'none';
            manualWrap.style.display = 'none';
        }
    });

    function manualDecrypt() {
        const inputText = document.getElementById('cipherInput').value.trim();
        const customKey = document.getElementById('manualDecKey').value;
        const decBox = document.getElementById('decryptOutput');
        const decArea = document.getElementById('decryptArea');

        let cipherText = inputText.replace(/-----BEGIN GOB ENCRYPTED MESSAGE-----/g, "")
                                  .replace(/-----END GOB ENCRYPTED MESSAGE-----/g, "")
                                  .trim();
        try {
            const boundDecryptionKey = customKey + SYSTEM_CORE_SALT;
            const originalText = decryptData(cipherText, boundDecryptionKey);
            if (!originalText) throw new Error();

            decBox.textContent = originalText;
            decArea.style.display = 'block';
            document.getElementById('manualDecWrapper').style.border = "1px dashed var(--primary-color)";
        } catch (e) {
            decBox.textContent = ">> DECRYPTION FAILED: INCORRECT EXTERNAL KEY OR INVALID SYSTEM ORIGIN.";
            decArea.style.display = 'block';
        }
    }

    // --- 5. PDF 다운로드 기능 ---
    function downloadPDF(elementId, filename) {
        if (typeof html2pdf === 'undefined') {
            alert("SYSTEM ERROR: PDF 렌더링 모듈을 불러올 수 없습니다. 인터넷이 연결된 브라우저(Safari, Chrome 등)를 사용해 주십시오.");
            return;
        }

        const element = document.getElementById(elementId);
        
        const opt = {
            margin:       10,
            filename:     filename,
            image:        { type: 'jpeg', quality: 0.98 },
            html2canvas:  { scale: 2, backgroundColor: '#000000' }, // 터미널 감성 유지
            jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
        };

        // PDF 생성 시작
        html2pdf().set(opt).from(element).save().then(() => {
            console.log('PDF Export Complete');
        }).catch(err => {
            alert('SYSTEM ERROR: PDF Export Failed.');
            console.error(err);
        });
    }
</script>

